# Copy to .env locally if desired; never commit filled credentials or raw mail.
# Shell scripts read exported environment variables; they do not source this file.
NEWSLETTER_APP_NAME=smartdrivingcar-newsletter-publisher
NEWSLETTER_GITHUB_REPOSITORY=PrincetonUniversity/smartdrivingcar
NEWSLETTER_AZURE_TENANT_ID=
NEWSLETTER_AZURE_CLIENT_ID=
# Confirm the actual Microsoft 365 mailbox UPN with its owner.
NEWSLETTER_MAILBOX=
NEWSLETTER_ALLOWED_AUTHOR=alaink@princeton.edu
NEWSLETTER_LIST_ADDRESS=smartdrivingcars@princeton.edu
NEWSLETTER_LOOKBACK_DAYS=90
NEWSLETTER_MAX_AGE_DAYS=0
NEWSLETTER_PUBLIC_URL=https://smartdrivingcar.com
# Optional: repository secrets, not variables.
HEALTHCHECKS_PING_URL=
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
RESEND_NOTIFY_IDLE=false
RESEND_NOTIFY_START=false
# For a local Docker preview only: short-lived token obtained after authorization.
GRAPH_ACCESS_TOKEN=
